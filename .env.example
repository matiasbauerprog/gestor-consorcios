SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRES_MIN=60
DATABASE_URL=sqlite:///./consorcio.db
# Para producción en Supabase Postgres (IMPORTANTE para Render: usar la URL de Connection Pooler / IPv4):
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[TU_PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
SEED_ENABLED=true
SEED_DEFAULT_PASSWORD=

# --- Fase 6a: SMTP para envío de PDFs ---
# Si SMTP_HOST está vacío, los emails se loggean al stdout (modo console, dev).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=consorcio@local
SMTP_FROM_NAME=Consorcio

# --- Multitenant / super admin ---
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Orígenes permitidos para CORS, separados por coma. En producción poner el
# dominio real del frontend. Default (si se omite): localhost:5173-5175.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Almacenamiento de archivos subidos ---
# local: disco (desarrollo y tests). s3: cualquier almacen S3-compatible.
STORAGE_BACKEND=local
# Segundos que vive la URL firmada de un adjunto.
URL_FIRMADA_SEGUNDOS=300
# Solo con STORAGE_BACKEND=s3. EL BUCKET TIENE QUE SER PRIVADO: si queda
# publico, la firma no protege nada porque el objeto se abre por su URL directa.
# Ejemplos de endpoint:
#   Supabase:   https://<PROJECT_REF>.supabase.co/storage/v1/s3
#   Cloudflare: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   AWS S3:     dejar vacio
S3_ENDPOINT_URL=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Recuperacion de contraseña ---
# Base del link que se manda por email. EN PRODUCCION tiene que ser el dominio
# real del frontend: si queda en localhost, el link que recibe el vecino no le
# sirve para nada.
FRONTEND_URL=http://localhost:5173
# Minutos que vive el link antes de vencer.
RECUPERACION_TOKEN_MINUTOS=60
# Tope de links que puede pedir un mismo usuario por hora.
RECUPERACION_MAX_POR_HORA=3

# --- Registro de errores ---
# Dias que se conserva un error antes de borrarse solo. La purga corre al
# arrancar el servicio.
ERRORES_RETENCION_DIAS=90
# Opcional. Con esto cargado los errores ademas se mandan a Sentry, que es lo
# que AVISA -- el registro propio deja encontrar, no enterarse.
# Va por variable de entorno y no por la interfaz a proposito: tiene que
# arrancar antes de que algo pueda fallar, y una config guardada en la base no
# esta disponible si el problema es justamente la base.
# Requiere: pip install sentry-sdk
SENTRY_DSN=
